   "id": "teo",
   "name": "Teo",
   "classId": "warrior",
   "xp": {
    "warrior": 250
   },
   "passive": null
  },
  "before": [
   {
    "scene": "bedroom",
    "text": "Novembre 1996. Mezzanotte meno tredici. Fuori piove da tre giorni."
   },
   {
    "scene": "bedroom",
    "who": "Nico",
    "text": "Ancora un tiro, Teo. Uno solo. Il Re Senzavolto è a due caselle."
   },
   {
    "scene": "bedroom",
    "who": "Teo",
    "text": "Hai detto \"uno solo\" quaranta minuti fa. Adesso tocca a me."
   },
   {
    "scene": "bedroom",
    "who": "Nico",
    "text": "È un gioco per UN giocatore. C'è scritto sulla scatola."
   },
   {
    "scene": "bedroom",
    "who": "Teo",
    "text": "E la mamma ha detto che il computer è di tutti e due. Un'unità a testa, come sempre."
   },
   {
    "scene": "bedroom",
    "who": "Nico",
    "text": "Va bene. Ma se perdi, il salvataggio lo tengo io."
   },
   {
    "scene": "crt",
    "text": "CRONACHE DI VALDOMBRA. Livello 1: il guado."
   },
   {
    "scene": "crt",
    "who": "Teo",
    "text": "Brando davanti, Lia dietro. Oris cura chi resta indietro."
   },
   {
    "scene": "crt",
    "who": "Nico",
    "text": "Lo so come si gioca. Muoviti."
   }
  ],
  "after": [
   {
    "scene": "crt",
    "text": "VITTORIA."
   },
   {
    "scene": "crt",
    "who": "Teo",
    "text": "Visto? Neanche un'unità persa."
   },
   {
    "scene": "crt",
    "who": "Nico",
    "text": "Fortuna. Dammi il mouse. Il Re lo batto io. Da solo, tutti i turni miei."
   },
   {
    "scene": "bedroom",
    "fx": "shake",
    "text": "Un tuono. La lampada sfarfalla. Il modem, spento, comincia a fischiare."
   },
   {
    "scene": "crt",
    "fx": "glitch",
    "who": "???",
    "text": "GIOCATORE 2 RILEVATO. VUOI GIOCARE TUTTI I TURNI?"
   },
   {
    "scene": "crt",
    "who": "Nico",
    "text": "…Sì."
   },
   {
    "scene": "crt",
    "who": "Teo",
    "text": "Nico, non toccare niente! Lo schermo… si sta piegando."
   },
   {
    "scene": "crt",
    "fx": "suck",
    "text": "Lo schermo si apre come una bocca. Il pavimento diventa luce."
   },
   {
    "scene": "black",
    "fx": "flash",
    "who": "Teo",
    "text": "NICO!"
   }
  ]
 },
