   {
    "scene": "black",
    "text": "Odore d'erba bagnata. Niente moquette. Niente computer."
   },
   {
    "scene": "map",
    "who": "Teo",
    "text": "Questo è il campo del primo livello. Ma è vero. Ed è enorme."
   },
   {
    "scene": "map",
    "who": "Lia",
    "text": "Brando, guarda. Uno sconosciuto che tiene la spada al contrario."
   },
   {
    "scene": "map",
    "who": "Brando",
    "text": "Vestiti strani, faccia da nuovo arrivato. Sai combattere, ragazzo?"
   },
   {
    "scene": "map",
    "who": "Teo",
    "text": "Io vi conosco! Brando sta sempre in prima fila. Lia non sbaglia mai un tiro."
   },
   {
    "scene": "map",
    "who": "Lia",
    "text": "Ci conosce. Questo non mi piace per niente."
   },
   {
    "scene": "map",
    "who": "Teo",
    "text": "Avete visto mio fratello? Quattordici anni, più alto di me, sempre arrabbiato."
   },
   {
    "scene": "map",
    "fx": "shake",
    "who": "Brando",
    "text": "Abbiamo visto solo i corvi del Re. E stanno arrivando."
   },
   {
    "scene": "map",
    "who": "Lia",
    "text": "Sono troppi. Teniamo la collina per cinque round, poi arrivano quelli del villaggio. E il ragazzo non deve cadere."
   }
  ],
  "after": [
   {
    "scene": "map",
    "who": "Brando",
    "text": "Le gambe reggono, ragazzo? Per uno nuovo, niente male."
   },
   {
    "scene": "map",
    "who": "Fiora",
    "text": "Ho visto tutto dal mulino. Sono Fiora: curo le ferite e faccio domande. Tu da dove vieni?"
